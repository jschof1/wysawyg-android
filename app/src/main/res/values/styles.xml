<resources>
    <style name="SE" />
    <!-- Type scale: Manrope 400/600/700. -->
    <style name="SE.Text" parent="TextAppearance.AppCompat">
        <item name="android:fontFamily">@font/manrope</item>
        <item name="fontFamily">@font/manrope</item>
        <item name="android:textColor">@color/se_text_primary</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="SE.TextView" parent="Widget.AppCompat.TextView">
        <item name="android:textAppearance">@style/SE.Text.Body</item>
    </style>

    <style name="SE.Text.Wordmark">
        <item name="android:textSize">30sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="SE.Text.Hero">
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="SE.Text.Section">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="SE.Text.Row">
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/manrope_semibold</item>
        <item name="fontFamily">@font/manrope_semibold</item>
    </style>
    <style name="SE.Text.RowStrong" parent="SE.Text.Row">
        <item name="android:textStyle">bold</item>
    </style>
    <style name="SE.Text.Body">
        <item name="android:textSize">16sp</item>
    </style>
    <style name="SE.Text.Meta">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/se_text_secondary</item>
    </style>
    <style name="SE.Text.Label" parent="SE.Text.Meta">
        <item name="android:fontFamily">@font/manrope_semibold</item>
        <item name="fontFamily">@font/manrope_semibold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
    </style>
    <style name="SE.Text.Button">
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/manrope_semibold</item>
        <item name="fontFamily">@font/manrope_semibold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@null</item>
    </style>

    <!-- Views -->
    <style name="SE.Wordmark">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">@style/SE.Text.Wordmark</item>
    </style>
    <style name="SE.Hero">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textAppearance">@style/SE.Text.Hero</item>
    </style>
    <style name="SE.Title">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">@style/SE.Text.Section</item>
    </style>
    <style name="SE.Body">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">@style/SE.Text.Body</item>
    </style>
    <style name="SE.Meta">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">@style/SE.Text.Meta</item>
    </style>
    <style name="SE.GroupLabel" parent="SE.Meta">
        <item name="android:textAppearance">@style/SE.Text.Label</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>

    <style name="SE.Card" parent="Widget.Material3.CardView.Filled">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="cardBackgroundColor">@color/se_surface</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
    </style>
    <style name="SE.Card.Hero">
        <item name="cardBackgroundColor">@color/se_hero</item>
    </style>
    <style name="SE.CardBody">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">20dp</item>
    </style>
    <style name="SE.Inset" parent="Widget.Material3.CardView.Outlined">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="cardBackgroundColor">@android:color/transparent</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/se_divider</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- A whole-row navigation target: icon, label, optional value, chevron. -->
    <style name="SE.Row">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
    <style name="SE.RowIcon">
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_height">24dp</item>
        <item name="android:layout_marginEnd">16dp</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="tint">@color/se_accent</item>
    </style>
    <style name="SE.RowText">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
    </style>
    <style name="SE.RowTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">@style/SE.Text.Row</item>
    </style>
    <style name="SE.RowValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">12dp</item>
        <item name="android:textAppearance">@style/SE.Text.Body</item>
        <item name="android:textColor">@color/se_text_secondary</item>
    </style>
    <style name="SE.Chevron">
        <item name="android:layout_width">20dp</item>
        <item name="android:layout_height">20dp</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:src">@drawable/se_chevron_right</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="tint">@color/se_text_secondary</item>
    </style>
    <style name="SE.Divider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/se_divider</item>
    </style>
    <style name="SE.Badge">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">12dp</item>
        <item name="android:minWidth">32dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingBottom">2dp</item>
        <item name="android:background">@drawable/se_badge</item>
        <item name="android:textAppearance">@style/SE.Text.Meta</item>
        <item name="android:textColor">@color/se_text_primary</item>
        <item name="android:fontFamily">@font/manrope_semibold</item>
        <item name="fontFamily">@font/manrope_semibold</item>
    </style>

    <style name="SE.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textAppearance">@style/SE.Text.Button</item>
        <item name="backgroundTint">@color/se_button_bg</item>
        <item name="android:textColor">@color/se_button_text</item>
        <item name="iconTint">@color/se_button_text</item>
    </style>
    <style name="SE.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textAppearance">@style/SE.Text.Button</item>
        <item name="android:textColor">@color/se_text_primary</item>
        <item name="iconTint">@color/se_text_primary</item>
        <item name="strokeColor">@color/se_outline</item>
    </style>
    <style name="SE.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:textAppearance">@style/SE.Text.Button</item>
        <item name="android:textColor">@color/se_accent</item>
    </style>

    <style name="SE.Switch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="trackTint">@color/se_switch_track</item>
        <item name="thumbTint">@color/se_switch_thumb</item>
        <item name="trackDecorationTint">@color/se_switch_outline</item>
        <item name="thumbIcon">@drawable/se_switch_check</item>
        <item name="thumbIconTint">@color/se_switch_icon</item>
        <item name="android:minHeight">48dp</item>
    </style>
    <!-- A switch row: label + helper on the left, one toggle. -->
    <style name="SE.SwitchRow" parent="SE.Switch">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textAppearance">@style/SE.Text.Row</item>
    </style>

    <style name="SE.Field" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxStrokeColor">@color/se_accent</item>
        <item name="hintTextColor">@color/se_accent</item>
    </style>

    <style name="SE.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">64dp</item>
        <item name="navigationIcon">@drawable/se_arrow_back</item>
        <item name="navigationIconTint">@color/se_text_primary</item>
        <item name="titleTextAppearance">@style/SE.Text.Section</item>
        <item name="subtitleTextAppearance">@style/SE.Text.Meta</item>
        <item name="android:background">@color/se_background</item>
    </style>

    <style name="SE.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/se_chip_bg</item>
        <item name="android:textColor">@color/se_chip_text</item>
        <item name="chipStrokeColor">@color/se_chip_stroke</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="checkedIconTint">@color/se_on_accent</item>
        <item name="chipMinHeight">44dp</item>
        <item name="android:textAppearance">@style/SE.Text.Button</item>
        <item name="shapeAppearance">@style/SE.Shape.Chip</item>
    </style>
    <style name="SE.Shape.Chip" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>
</resources>
