<resources>
    <style name="Base.Theme.Wysawyg" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/se_accent</item>
        <item name="colorOnPrimary">@color/se_on_accent</item>
        <item name="colorPrimaryContainer">@color/se_hero</item>
        <item name="colorOnPrimaryContainer">@color/se_text_primary</item>
        <item name="colorSecondary">@color/se_accent</item>
        <item name="colorOnSecondary">@color/se_on_accent</item>
        <item name="colorSecondaryContainer">@color/se_raised</item>
        <item name="colorOnSecondaryContainer">@color/se_text_primary</item>
        <item name="colorTertiary">@color/se_brass</item>
        <item name="colorSurface">@color/se_surface</item>
        <item name="colorOnSurface">@color/se_text_primary</item>
        <item name="colorOnSurfaceVariant">@color/se_text_secondary</item>
        <item name="colorSurfaceContainerLowest">@color/se_surface</item>
        <item name="colorSurfaceContainerLow">@color/se_surface</item>
        <item name="colorSurfaceContainer">@color/se_surface</item>
        <item name="colorSurfaceContainerHigh">@color/se_surface</item>
        <item name="colorSurfaceContainerHighest">@color/se_raised</item>
        <item name="colorOutline">@color/se_outline</item>
        <item name="colorOutlineVariant">@color/se_divider</item>
        <item name="colorError">@color/se_error</item>
        <item name="android:colorBackground">@color/se_background</item>
        <item name="android:windowBackground">@color/se_background</item>
        <item name="android:statusBarColor">@color/se_background</item>
        <item name="android:navigationBarColor">@color/se_background</item>
        <item name="android:windowLightStatusBar">@bool/se_light_bars</item>
        <item name="android:textColorPrimary">@color/se_text_primary</item>
        <item name="android:textColorSecondary">@color/se_text_secondary</item>
        <!-- Font comes from text appearances, so each style can pick its own weight. -->
        <item name="android:textViewStyle">@style/SE.TextView</item>
        <item name="textAppearanceHeadlineSmall">@style/SE.Text.Hero</item>
        <item name="textAppearanceTitleLarge">@style/SE.Text.Section</item>
        <item name="textAppearanceTitleMedium">@style/SE.Text.Row</item>
        <item name="textAppearanceTitleSmall">@style/SE.Text.RowStrong</item>
        <item name="textAppearanceBodyLarge">@style/SE.Text.Body</item>
        <item name="textAppearanceBodyMedium">@style/SE.Text.Meta</item>
        <item name="textAppearanceBodySmall">@style/SE.Text.Meta</item>
        <item name="textAppearanceLabelLarge">@style/SE.Text.Button</item>
        <item name="textAppearanceLabelMedium">@style/SE.Text.Meta</item>
        <item name="materialSwitchStyle">@style/SE.Switch</item>
        <item name="bottomSheetDialogTheme">@style/SE.BottomSheet</item>
    </style>

    <style name="Theme.Wysawyg" parent="Base.Theme.Wysawyg" />

    <style name="SE.BottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/SE.BottomSheet.Modal</item>
        <item name="android:navigationBarColor">@color/se_surface</item>
    </style>
    <style name="SE.BottomSheet.Modal" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">@color/se_surface</item>
        <item name="shapeAppearance">@style/SE.Shape.Sheet</item>
    </style>
    <style name="SE.Shape.Sheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">24dp</item>
        <item name="cornerSizeTopRight">24dp</item>
    </style>
</resources>
