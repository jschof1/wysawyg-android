<resources>
    <style name="SE.Overlay" />
    <!-- Overlay views are inflated by a Service, so every colour is explicit. -->
    <style name="SE.Overlay.Text">
        <item name="android:fontFamily">@font/manrope</item>
        <item name="android:textColor">@color/se_panel_text</item>
    </style>
    <style name="SE.Overlay.Meta" parent="SE.Overlay.Text">
        <item name="android:textColor">@color/se_panel_secondary</item>
        <item name="android:textSize">14sp</item>
    </style>
    <style name="SE.Overlay.Button" parent="SE.Overlay.Text">
        <item name="android:layout_height">48dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:background">@drawable/se_overlay_secondary</item>
    </style>
    <style name="SE.Overlay.Button.Primary">
        <item name="android:textColor">@color/se_on_mint</item>
        <item name="android:background">@drawable/se_overlay_primary</item>
    </style>
</resources>
