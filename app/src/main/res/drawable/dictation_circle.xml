<?xml version="1.0" encoding="utf-8"?>
<!-- Idle microphone bubble: mint with a soft forest ring, recognisable over any app. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="oval">
            <solid android:color="@color/se_panel" />
            <stroke android:width="1dp" android:color="@color/se_panel_outline" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/se_mint" />
            <stroke android:width="1dp" android:color="@color/se_panel_outline" />
        </shape>
    </item>
</selector>
