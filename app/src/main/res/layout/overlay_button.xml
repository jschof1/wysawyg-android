<?xml version="1.0" encoding="utf-8"?>
<!-- Inflated by a Service without AppCompat, so platform android:tint is the one that works. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools" tools:ignore="UseAppTint"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="4dp">

    <!-- Idle: the mint microphone bubble, plus a chip when transcripts are waiting. -->
    <FrameLayout android:id="@+id/idlePanel" android:layout_width="match_parent"
        android:layout_height="56dp" android:layout_gravity="end">
        <Button android:id="@+id/showRecovery" style="@style/SE.Overlay.Button"
            android:layout_width="wrap_content" android:layout_gravity="start|center_vertical"
            android:layout_marginEnd="64dp" android:paddingStart="16dp" android:paddingEnd="16dp"
            android:background="@drawable/se_overlay_chip" android:textSize="14sp"
            android:visibility="gone" />
        <ImageButton android:id="@+id/dictationButton" android:layout_width="56dp"
            android:layout_height="56dp" android:layout_gravity="end"
            android:background="@drawable/dictation_circle" android:src="@drawable/se_mic"
            android:tint="@color/se_on_mint" android:padding="15dp" android:scaleType="fitCenter"
            android:elevation="8dp" android:contentDescription="@string/start_dictation" />
        <ProgressBar android:id="@+id/dictationProgress" style="?android:attr/progressBarStyleSmall"
            android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="16dp" android:elevation="9dp"
            android:indeterminateTint="@color/se_mint" android:visibility="gone"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <!-- Recording -->
    <LinearLayout android:id="@+id/recordingPanel" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="vertical"
        android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="10dp" android:paddingBottom="14dp"
        android:background="@drawable/dictation_panel" android:elevation="8dp" android:visibility="gone">
        <LinearLayout android:id="@+id/recordingGrip" android:layout_width="match_parent"
            android:layout_height="32dp" android:gravity="center_vertical" android:orientation="horizontal"
            android:contentDescription="@string/drag_dictation">
            <ImageView android:layout_width="18dp" android:layout_height="18dp"
                android:src="@drawable/se_brand_mark" android:tint="@color/se_brass_on_panel"
                android:importantForAccessibility="no" />
            <TextView style="@style/SE.Overlay.Text" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginStart="8dp"
                android:text="@string/app_name" android:textSize="14sp" android:textStyle="bold"
                android:importantForAccessibility="no" />
            <View android:layout_width="8dp" android:layout_height="8dp" android:layout_marginStart="12dp"
                android:background="@drawable/se_dot" />
            <TextView style="@style/SE.Overlay.Meta" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:layout_marginStart="6dp"
                android:text="@string/recording_drag_hint" android:importantForAccessibility="no" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/recordingTimer" style="@style/SE.Overlay.Text"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/recording_zero" android:textSize="22sp" android:textStyle="bold"
                android:fontFeatureSettings="tnum" />
            <ProgressBar android:id="@+id/recordingLevel" style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="10dp"
                android:layout_marginStart="16dp" android:max="100"
                android:progressDrawable="@drawable/se_overlay_level"
                android:contentDescription="@string/sound_level" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:orientation="horizontal">
            <Button android:id="@+id/stopRecording" style="@style/SE.Overlay.Button.Primary"
                android:layout_width="0dp" android:layout_weight="1.4"
                android:text="@string/stop_recording" android:contentDescription="@string/finish_dictation" />
            <Button android:id="@+id/cancelRecording" style="@style/SE.Overlay.Button"
                android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="8dp"
                android:text="@string/cancel_recording" />
        </LinearLayout>
        <TextView style="@style/SE.Overlay.Meta" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="8dp"
            android:text="@string/recording_limit_short" android:textSize="12sp" />
    </LinearLayout>

    <!-- Recovery -->
    <LinearLayout android:id="@+id/recoveryPanel" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="vertical"
        android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="10dp" android:paddingBottom="14dp"
        android:background="@drawable/dictation_panel" android:elevation="8dp" android:visibility="gone">
        <TextView android:id="@+id/recoveryGrip" style="@style/SE.Overlay.Meta" android:layout_width="match_parent"
            android:layout_height="24dp" android:gravity="center" android:text="@string/drag_recovery"
            android:textSize="12sp" android:contentDescription="@string/drag_recovery" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="48dp"
            android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/recoveryTitle" style="@style/SE.Overlay.Text" android:layout_width="0dp"
                android:layout_weight="1" android:layout_height="wrap_content"
                android:textStyle="bold" android:textSize="16sp" />
            <Button android:id="@+id/collapseRecovery" style="@style/SE.Overlay.Button"
                android:layout_width="wrap_content" android:paddingStart="16dp" android:paddingEnd="16dp"
                android:text="@string/later_recovery" />
        </LinearLayout>
        <TextView android:id="@+id/recoveryStatus" style="@style/SE.Overlay.Meta" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="4dp"
            android:textColor="@color/se_brass_on_panel" android:textSize="13sp" />
        <ScrollView android:id="@+id/recoveryScroll" android:layout_width="match_parent"
            android:layout_height="104dp" android:layout_marginTop="8dp" android:fillViewport="true">
            <TextView android:id="@+id/recoveryText" style="@style/SE.Overlay.Text" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textSize="16sp" />
        </ScrollView>
        <LinearLayout android:id="@+id/recoveryActions" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
            <Button android:id="@+id/copyRecovery" style="@style/SE.Overlay.Button" android:layout_width="0dp"
                android:layout_weight="1" android:text="@string/copy_recovery" />
            <Button android:id="@+id/insertRecovery" style="@style/SE.Overlay.Button.Primary" android:layout_width="0dp"
                android:layout_weight="1.5" android:layout_marginStart="8dp" android:text="@string/insert_here" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:orientation="horizontal">
            <Button android:id="@+id/previousRecovery" style="@style/SE.Overlay.Button" android:layout_width="48dp"
                android:text="@string/previous_recovery_symbol" android:contentDescription="@string/previous_recovery" />
            <Button android:id="@+id/discardRecovery" style="@style/SE.Overlay.Button" android:layout_width="0dp"
                android:layout_weight="1" android:layout_marginStart="8dp" android:layout_marginEnd="8dp"
                android:text="@string/discard_recovery" />
            <Button android:id="@+id/nextRecovery" style="@style/SE.Overlay.Button" android:layout_width="48dp"
                android:text="@string/next_recovery_symbol" android:contentDescription="@string/next_recovery" />
        </LinearLayout>
        <Button android:id="@+id/retryRecoverySave" style="@style/SE.Overlay.Button" android:layout_width="match_parent"
            android:layout_marginTop="8dp" android:text="@string/retry_recovery_save" android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
