<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="2dp">
    <FrameLayout android:id="@+id/idlePanel" android:layout_width="match_parent"
        android:layout_height="48dp" android:layout_gravity="end">
        <Button android:id="@+id/showRecovery" android:layout_width="wrap_content"
            android:layout_height="48dp" android:layout_gravity="start"
            android:layout_marginEnd="56dp" android:visibility="gone" />
        <ImageButton android:id="@+id/dictationButton" android:layout_width="48dp"
            android:layout_height="48dp" android:layout_gravity="end"
            android:background="@drawable/dictation_circle" android:src="@drawable/ic_dictation_mic"
            android:padding="13dp" android:contentDescription="@string/start_dictation" />
        <ProgressBar android:id="@+id/dictationProgress" style="?android:attr/progressBarStyleSmall"
            android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center"
            android:indeterminateTint="#FFFFFF" android:visibility="gone"
            android:importantForAccessibility="no" />
    </FrameLayout>
    <LinearLayout android:id="@+id/recordingPanel" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp"
        android:background="@drawable/dictation_panel" android:visibility="gone">
        <TextView android:id="@+id/recordingGrip" android:layout_width="match_parent"
            android:layout_height="24dp" android:gravity="center" android:text="@string/drag_dictation"
            android:textColor="#C8CBE2" android:textSize="12sp" android:contentDescription="@string/drag_dictation" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/recordingTimer" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="@string/recording_zero"
                android:textColor="#FFFFFF" android:textSize="22sp" android:fontFamily="monospace" />
            <ProgressBar android:id="@+id/recordingLevel" style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="12dp"
                android:layout_marginStart="16dp" android:max="100" android:progressTint="#8CE3C3"
                android:progressBackgroundTint="#454B67" android:contentDescription="@string/sound_level" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:orientation="horizontal">
            <Button android:id="@+id/stopRecording" android:layout_width="0dp"
                android:layout_weight="1" android:layout_height="48dp" android:minWidth="0dp"
                android:text="@string/stop_recording" android:contentDescription="@string/finish_dictation" />
            <Button android:id="@+id/cancelRecording" android:layout_width="0dp"
                android:layout_weight="1" android:layout_height="48dp" android:minWidth="0dp"
                android:layout_marginStart="8dp" android:text="@string/cancel_recording" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/recoveryPanel" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp"
        android:background="@drawable/dictation_panel" android:visibility="gone">
        <TextView android:id="@+id/recoveryGrip" android:layout_width="match_parent"
            android:layout_height="24dp" android:gravity="center" android:text="@string/drag_recovery"
            android:textColor="#C8CBE2" android:textSize="12sp" android:contentDescription="@string/drag_recovery" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="48dp"
            android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/recoveryTitle" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="16sp" />
            <Button android:id="@+id/collapseRecovery" android:layout_width="wrap_content"
                android:layout_height="48dp" android:minWidth="64dp" android:text="@string/later_recovery" />
        </LinearLayout>
        <TextView android:id="@+id/recoveryStatus" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="4dp"
            android:textColor="#E1D8BA" android:textSize="12sp" />
        <ScrollView android:id="@+id/recoveryScroll" android:layout_width="match_parent"
            android:layout_height="104dp" android:layout_marginTop="8dp" android:fillViewport="true">
            <TextView android:id="@+id/recoveryText" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="16sp" />
        </ScrollView>
        <LinearLayout android:id="@+id/recoveryActions" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="horizontal">
            <Button android:id="@+id/copyRecovery" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="48dp" android:minWidth="0dp" android:text="@string/copy_recovery" />
            <Button android:id="@+id/insertRecovery" android:layout_width="0dp" android:layout_weight="1.5"
                android:layout_height="48dp" android:minWidth="0dp" android:text="@string/insert_here" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <Button android:id="@+id/previousRecovery" android:layout_width="48dp" android:layout_height="48dp"
                android:minWidth="0dp" android:text="@string/previous_recovery_symbol" android:contentDescription="@string/previous_recovery" />
            <Button android:id="@+id/discardRecovery" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="48dp" android:minWidth="0dp" android:text="@string/discard_recovery" />
            <Button android:id="@+id/nextRecovery" android:layout_width="48dp" android:layout_height="48dp"
                android:minWidth="0dp" android:text="@string/next_recovery_symbol" android:contentDescription="@string/next_recovery" />
        </LinearLayout>
        <Button android:id="@+id/retryRecoverySave" android:layout_width="match_parent"
            android:layout_height="48dp" android:text="@string/retry_recovery_save" android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
