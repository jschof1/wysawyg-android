<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/moreRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/moreToolbar"
        style="@style/SE.Toolbar"
        app:title="@string/tools_more" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/moreScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="28dp">

            <!-- Input -->
            <com.google.android.material.card.MaterialCardView
                style="@style/SE.Card"
                android:layout_marginTop="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SE.GroupLabel"
                        android:accessibilityHeading="true"
                        android:text="@string/more_group_input" />

                    <LinearLayout
                        android:id="@+id/enableKeyboardButton"
                        style="@style/SE.Row"
                        android:minHeight="72dp">

                        <ImageView
                            style="@style/SE.RowIcon"
                            android:src="@drawable/se_keyboard" />

                        <LinearLayout style="@style/SE.RowText">

                            <TextView
                                style="@style/SE.RowTitle"
                                android:text="@string/more_keyboard" />

                            <TextView
                                style="@style/SE.Meta"
                                android:text="@string/more_keyboard_help" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/keyboardStatus"
                            style="@style/SE.RowValue"
                            android:textSize="14sp" />

                        <ImageView style="@style/SE.Chevron" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Transcription -->
            <com.google.android.material.card.MaterialCardView style="@style/SE.Card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="12dp">

                    <TextView
                        style="@style/SE.GroupLabel"
                        android:accessibilityHeading="true"
                        android:text="@string/more_group_transcription" />

                    <RadioButton
                        android:id="@+id/onDeviceMode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="16dp"
                        android:buttonTint="@color/se_accent"
                        android:checked="true"
                        android:minHeight="48dp"
                        android:paddingStart="8dp"
                        android:text="@string/more_on_device"
                        android:textAppearance="@style/SE.Text.Row" />

                    <TextView
                        android:id="@+id/transcriptionStatus"
                        style="@style/SE.Meta"
                        android:paddingStart="48dp"
                        android:paddingEnd="16dp"
                        android:text="@string/works_offline" />

                    <TextView
                        style="@style/SE.Meta"
                        android:paddingStart="48dp"
                        android:paddingEnd="16dp"
                        android:text="@string/recording_limit" />

                    <RadioButton
                        android:id="@+id/cloudMode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginEnd="16dp"
                        android:buttonTint="@color/se_accent"
                        android:minHeight="48dp"
                        android:paddingStart="8dp"
                        android:text="@string/more_cloud"
                        android:textAppearance="@style/SE.Text.Row" />

                    <TextView
                        style="@style/SE.Meta"
                        android:paddingStart="48dp"
                        android:paddingEnd="16dp"
                        android:text="@string/cloud_upload_notice" />

                    <View
                        style="@style/SE.Divider"
                        android:layout_marginTop="12dp" />

                    <LinearLayout
                        android:id="@+id/advancedToggle"
                        style="@style/SE.Row">

                        <ImageView
                            style="@style/SE.RowIcon"
                            android:src="@drawable/se_cloud" />

                        <TextView
                            android:id="@+id/advancedToggleLabel"
                            style="@style/SE.RowTitle"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/more_cloud_settings" />

                        <ImageView
                            android:id="@+id/advancedChevron"
                            style="@style/SE.Chevron"
                            android:src="@drawable/se_expand_more" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/advancedSettings"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:visibility="gone">

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/SE.Field"
                            android:hint="@string/server_url">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/alarmaUrl"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textUri" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/SE.Field"
                            android:hint="@string/api_key"
                            app:endIconMode="password_toggle">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/apiKey"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textPassword" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/SE.Field"
                            android:hint="@string/model">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/modelName"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="text" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/SE.Field"
                            android:hint="@string/system_prompt">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/systemPrompt"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="top"
                                android:inputType="textMultiLine"
                                android:minLines="3" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Backup -->
            <com.google.android.material.card.MaterialCardView style="@style/SE.Card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SE.GroupLabel"
                        android:accessibilityHeading="true"
                        android:text="@string/more_group_backup" />

                    <LinearLayout
                        android:id="@+id/exportSettingsButton"
                        style="@style/SE.Row"
                        android:minHeight="72dp">

                        <ImageView
                            style="@style/SE.RowIcon"
                            android:src="@drawable/se_upload" />

                        <LinearLayout style="@style/SE.RowText">

                            <TextView
                                style="@style/SE.RowTitle"
                                android:text="@string/export_settings" />

                            <TextView
                                style="@style/SE.Meta"
                                android:text="@string/more_export_help" />
                        </LinearLayout>

                        <ImageView style="@style/SE.Chevron" />
                    </LinearLayout>

                    <View style="@style/SE.Divider" />

                    <LinearLayout
                        android:id="@+id/importSettingsButton"
                        style="@style/SE.Row">

                        <ImageView
                            style="@style/SE.RowIcon"
                            android:src="@drawable/se_download" />

                        <TextView
                            style="@style/SE.RowTitle"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/import_settings" />

                        <ImageView style="@style/SE.Chevron" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Support -->
            <com.google.android.material.card.MaterialCardView style="@style/SE.Card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SE.GroupLabel"
                        android:accessibilityHeading="true"
                        android:text="@string/more_group_support" />

                    <LinearLayout
                        android:id="@+id/speechNotices"
                        style="@style/SE.Row"
                        android:minHeight="72dp">

                        <ImageView
                            style="@style/SE.RowIcon"
                            android:src="@drawable/se_gavel" />

                        <LinearLayout style="@style/SE.RowText">

                            <TextView
                                style="@style/SE.RowTitle"
                                android:text="@string/more_licences" />

                            <TextView
                                style="@style/SE.Meta"
                                android:text="@string/more_licences_help" />
                        </LinearLayout>

                        <ImageView style="@style/SE.Chevron" />
                    </LinearLayout>

                    <View style="@style/SE.Divider" />

                    <LinearLayout
                        android:id="@+id/viewLogButton"
                        style="@style/SE.Row">

                        <ImageView
                            style="@style/SE.RowIcon"
                            android:src="@drawable/se_article" />

                        <TextView
                            style="@style/SE.RowTitle"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/view_log" />

                        <ImageView style="@style/SE.Chevron" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingStart="56dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="8dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/shareLogButton"
                            style="@style/SE.Button.Outlined"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/share_log" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/clearLogButton"
                            style="@style/SE.Button.Text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/clear_log" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
