<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/styleRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/styleToolbar"
        style="@style/SE.Toolbar"
        app:subtitle="@string/style_screen_subtitle"
        app:title="@string/style_title" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/styleScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="28dp">

            <!-- Master switch -->
            <com.google.android.material.card.MaterialCardView
                style="@style/SE.Card"
                android:layout_marginTop="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="8dp"
                    android:paddingBottom="16dp">

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/matchAppSwitch"
                        style="@style/SE.SwitchRow"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:text="@string/style_match_app"
                        android:textAppearance="@style/SE.Text.RowStrong"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/matchHelp"
                        style="@style/SE.Meta"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:text="@string/style_match_help" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Per-app styles -->
            <com.google.android.material.card.MaterialCardView style="@style/SE.Card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="4dp">

                    <TextView
                        style="@style/SE.GroupLabel"
                        android:accessibilityHeading="true"
                        android:paddingStart="20dp"
                        android:text="@string/style_group_apps" />

                    <LinearLayout
                        android:id="@+id/styleRows"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Live preview -->
            <com.google.android.material.card.MaterialCardView style="@style/SE.Card.Hero">

                <LinearLayout style="@style/SE.CardBody">

                    <TextView
                        style="@style/SE.Title"
                        android:accessibilityHeading="true"
                        android:text="@string/style_try_title" />

                    <TextView
                        style="@style/SE.Meta"
                        android:layout_marginTop="2dp"
                        android:text="@string/style_try_help" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/SE.Field"
                        android:layout_marginTop="16dp"
                        android:hint="@string/style_try_hint"
                        app:boxBackgroundColor="@color/se_surface">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/stylePreviewInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="top"
                            android:inputType="textMultiLine|textCapSentences"
                            android:minLines="2"
                            android:textAppearance="@style/SE.Text.Body" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <LinearLayout
                        android:id="@+id/stylePreviewOutput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:accessibilityLiveRegion="polite"
                        android:orientation="vertical" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Cleanup and commands -->
            <com.google.android.material.card.MaterialCardView style="@style/SE.Card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="16dp">

                    <TextView
                        style="@style/SE.GroupLabel"
                        android:accessibilityHeading="true"
                        android:paddingStart="20dp"
                        android:text="@string/style_group_cleanup" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/fillerSwitch"
                        style="@style/SE.SwitchRow"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:text="@string/style_fillers" />

                    <TextView
                        style="@style/SE.Meta"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:text="@string/style_fillers_help" />

                    <View
                        style="@style/SE.Divider"
                        android:layout_marginTop="12dp" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/commandsSwitch"
                        style="@style/SE.SwitchRow"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:text="@string/style_commands" />

                    <TextView
                        style="@style/SE.Meta"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:text="@string/style_commands_hint" />

                    <View
                        style="@style/SE.Divider"
                        android:layout_marginTop="12dp" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/smartCleanupSwitch"
                        style="@style/SE.SwitchRow"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:text="@string/style_smart" />

                    <TextView
                        android:id="@+id/smartCleanupStatus"
                        style="@style/SE.Meta"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:text="@string/style_smart_hint" />

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/smartCleanupProgress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginEnd="20dp"
                        android:visibility="gone"
                        app:indicatorColor="@color/se_accent"
                        app:trackColor="@color/se_raised"
                        app:trackCornerRadius="4dp"
                        app:trackThickness="4dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/smartCleanupAction"
                        style="@style/SE.Button.Outlined"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        android:layout_marginTop="12dp"
                        android:text="@string/style_smart_resume"
                        android:visibility="gone"
                        app:icon="@drawable/se_download"
                        app:iconSize="20dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
