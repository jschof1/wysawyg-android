<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/homeScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/homeContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:importantForAccessibility="no"
                android:src="@drawable/se_brand_mark"
                app:tint="@color/se_brass" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/SE.Wordmark"
                    android:accessibilityHeading="true"
                    android:text="@string/app_title" />

                <TextView
                    style="@style/SE.Body"
                    android:text="@string/tagline"
                    android:textColor="@color/se_text_secondary" />
            </LinearLayout>
        </LinearLayout>

        <!-- Floating dictation status -->
        <com.google.android.material.card.MaterialCardView
            style="@style/SE.Card"
            android:layout_marginTop="24dp">

            <LinearLayout
                style="@style/SE.CardBody"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/SE.Title"
                            android:accessibilityHeading="true"
                            android:text="@string/section_dictation" />

                        <LinearLayout
                            android:id="@+id/statusLine"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/statusIcon"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/se_check_circle"
                                app:tint="@color/se_success" />

                            <TextView
                                android:id="@+id/statusText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="@string/status_paused"
                                android:textAppearance="@style/SE.Text.RowStrong"
                                android:textColor="@color/se_success" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/statusMeta"
                            style="@style/SE.Meta"
                            android:layout_marginTop="4dp"
                            android:text="@string/status_meta_offline" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/startOverlayButton"
                        style="@style/SE.Button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="@string/start_overlay"
                        app:icon="@drawable/se_mic"
                        app:iconSize="20dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/stopOverlayButton"
                        style="@style/SE.Button.Outlined"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="@string/stop_overlay"
                        android:visibility="gone"
                        app:icon="@drawable/se_pause"
                        app:iconSize="20dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/backgroundStatus"
                    style="@style/SE.Meta"
                    android:layout_marginTop="12dp"
                    android:text="@string/background_paused"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Setup checklist -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/setupCard"
            style="@style/SE.Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="8dp">

                <LinearLayout
                    android:id="@+id/setupHeader"
                    style="@style/SE.Row"
                    android:paddingStart="20dp"
                    android:paddingTop="16dp"
                    android:paddingEnd="20dp">

                    <LinearLayout style="@style/SE.RowText">

                        <TextView
                            android:id="@+id/setupTitle"
                            style="@style/SE.Title"
                            android:accessibilityHeading="true"
                            android:text="@string/setup_complete" />

                        <TextView
                            android:id="@+id/setupCount"
                            style="@style/SE.Meta"
                            android:visibility="gone" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/setupExpand"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/se_expand_more"
                        app:tint="@color/se_text_secondary" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/setupRows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/enableAccessibilityButton"
                        style="@style/SE.Row"
                        android:paddingStart="20dp">

                        <ImageView
                            android:id="@+id/accessibilityIcon"
                            style="@style/SE.RowIcon"
                            android:src="@drawable/se_check_circle" />

                        <LinearLayout style="@style/SE.RowText">

                            <TextView
                                android:id="@+id/accessibilityTitle"
                                style="@style/SE.RowTitle"
                                android:text="@string/setup_accessibility_done" />

                            <TextView
                                android:id="@+id/accessibilityHelp"
                                style="@style/SE.Meta"
                                android:text="@string/setup_accessibility_help"
                                android:visibility="gone" />
                        </LinearLayout>

                        <ImageView style="@style/SE.Chevron" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/allowBackgroundButton"
                        style="@style/SE.Row"
                        android:paddingStart="20dp">

                        <ImageView
                            android:id="@+id/batteryIcon"
                            style="@style/SE.RowIcon"
                            android:src="@drawable/se_check_circle" />

                        <LinearLayout style="@style/SE.RowText">

                            <TextView
                                android:id="@+id/batteryTitle"
                                style="@style/SE.RowTitle"
                                android:text="@string/setup_battery_done" />

                            <TextView
                                android:id="@+id/batteryHelp"
                                style="@style/SE.Meta"
                                android:text="@string/setup_battery_help"
                                android:visibility="gone" />
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/batteryChevron"
                            style="@style/SE.Chevron" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Writing style hero -->
        <com.google.android.material.card.MaterialCardView style="@style/SE.Card.Hero">

            <LinearLayout style="@style/SE.CardBody">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/SE.Hero"
                        android:accessibilityHeading="true"
                        android:text="@string/style_title" />

                    <TextView
                        android:id="@+id/styleBadge"
                        style="@style/SE.Badge"
                        android:background="@drawable/se_badge_surface"
                        android:drawablePadding="6dp"
                        android:paddingStart="12dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="6dp"
                        android:text="@string/status_on" />
                </LinearLayout>

                <TextView
                    style="@style/SE.Body"
                    android:layout_marginTop="2dp"
                    android:text="@string/style_tagline"
                    android:textColor="@color/se_text_secondary" />

                <com.google.android.material.card.MaterialCardView style="@style/SE.Inset">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/styleExampleOneMeta"
                            style="@style/SE.Meta" />

                        <TextView
                            android:id="@+id/styleExampleOne"
                            style="@style/SE.Body"
                            android:textSize="20sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView style="@style/SE.Inset">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/styleExampleTwoMeta"
                            style="@style/SE.Meta" />

                        <TextView
                            android:id="@+id/styleExampleTwo"
                            style="@style/SE.Body"
                            android:textSize="20sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/styleOffNote"
                    style="@style/SE.Meta"
                    android:layout_marginTop="12dp"
                    android:text="@string/style_off_note"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/openWritingStyle"
                    style="@style/SE.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="start|center_vertical"
                    android:text="@string/style_open"
                    app:icon="@drawable/se_arrow_forward"
                    app:iconGravity="end" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Tools -->
        <com.google.android.material.card.MaterialCardView style="@style/SE.Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/tryDictationButton"
                    style="@style/SE.Row"
                    android:minHeight="64dp">

                    <ImageView
                        style="@style/SE.RowIcon"
                        android:src="@drawable/se_mic" />

                    <LinearLayout style="@style/SE.RowText">

                        <TextView
                            style="@style/SE.RowTitle"
                            android:text="@string/try_dictation" />

                        <TextView
                            style="@style/SE.Meta"
                            android:text="@string/tools_try_help" />
                    </LinearLayout>

                    <ImageView style="@style/SE.Chevron" />
                </LinearLayout>

                <View style="@style/SE.Divider" />

                <LinearLayout
                    android:id="@+id/recoveredTranscriptsButton"
                    style="@style/SE.Row"
                    android:minHeight="64dp">

                    <ImageView
                        style="@style/SE.RowIcon"
                        android:src="@drawable/se_description" />

                    <LinearLayout style="@style/SE.RowText">

                        <TextView
                            style="@style/SE.RowTitle"
                            android:text="@string/recovered_transcripts" />

                        <TextView
                            android:id="@+id/recoveredHelp"
                            style="@style/SE.Meta"
                            android:text="@string/tools_recovered_help"
                            android:visibility="gone" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/recoveredCount"
                        style="@style/SE.Badge"
                        android:text="0" />

                    <ImageView style="@style/SE.Chevron" />
                </LinearLayout>

                <View style="@style/SE.Divider" />

                <LinearLayout
                    android:id="@+id/moreSettingsButton"
                    style="@style/SE.Row"
                    android:minHeight="64dp">

                    <ImageView
                        style="@style/SE.RowIcon"
                        android:src="@drawable/se_settings" />

                    <LinearLayout style="@style/SE.RowText">

                        <TextView
                            style="@style/SE.RowTitle"
                            android:text="@string/tools_more" />

                        <TextView
                            style="@style/SE.Meta"
                            android:text="@string/tools_more_help" />
                    </LinearLayout>

                    <ImageView style="@style/SE.Chevron" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/privacyPolicyButton"
            style="@style/SE.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/privacy_permissions" />

        <TextView
            android:id="@+id/footerText"
            style="@style/SE.Meta"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="@string/footer_local" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
